# Copie para .env na raiz do repositorio na VPS (cp .env.example .env). O .env nao e versionado.
# Este arquivo NAO contem segredos: senhas e chaves ficam em ./secrets/ (deploy/scripts/gerar-segredos.sh).

# Dominio atendido pelo Caddy; o DNS (registro A/AAAA) deve apontar para a VPS antes do primeiro "up".
PROSINT_DOMAIN=prosint.tech
# E-mail de contato da conta ACME (avisos de expiracao do Let's Encrypt).
ACME_EMAIL=responsavel@example.com
# Primeiro teste real: descomente para usar o staging do Let's Encrypt (certificado nao confiavel,
# sem consumir limites). Depois comente, apague o volume caddy_data e reinicie o proxy.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

MYSQL_DATABASE=prosint
MYSQL_USER=prosint

# Tag das imagens geradas localmente (use o hash do commit para permitir rollback).
PROSINT_VERSION=latest

# Opcionais (padroes do application.properties):
# GEMINI_MODEL=gemini-3.5-flash-lite
# DATAJUD_WORKER_ENABLED=true
# AUTH_LOGIN_POR_IP=20
# AUTH_CADASTRO_POR_IP=5
# IA_LIMITE_POR_USUARIO=30
# IA_LIMITE_GLOBAL=300
