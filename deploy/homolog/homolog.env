# Valores ficticios da homologacao. "localhost" faz o Caddy usar sua CA interna (sem ACME/Let's Encrypt).
PROSINT_DOMAIN=localhost
ACME_EMAIL=homologacao@example.invalid
MYSQL_DATABASE=prosint
MYSQL_USER=prosint
PROSINT_VERSION=homolog
# /24 da rede edge distinta da producao (172.31.250): permite homologar na mesma VPS.
PROSINT_EDGE_PREFIX=172.31.251
